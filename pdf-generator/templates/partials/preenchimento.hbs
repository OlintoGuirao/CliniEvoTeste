{{!-- Procedimento: Preenchimento --}}

<section class="section-block">
  <h2 class="section-title">Informações do Produto e Aplicação</h2>
  <div class="card-grid card-grid-2">
    <div class="field-card">
      <div class="field-label">Produto</div>
      <div class="field-value">{{default produto '—'}}</div>
    </div>
    <div class="field-card">
      <div class="field-label">Lote</div>
      <div class="field-value">{{default lote '—'}}</div>
    </div>
    <div class="field-card">
      <div class="field-label">Região</div>
      <div class="field-value">{{default regiao '—'}}</div>
    </div>
    <div class="field-card">
      <div class="field-label">Volume (ml)</div>
      <div class="field-value">{{default volume '—'}}</div>
    </div>
    <div class="field-card" style="grid-column: span 2;">
      <div class="field-label">Cânula / Agulha</div>
      <div class="field-value">{{default canulaAgulha '—'}}</div>
    </div>
  </div>
</section>

{{#if observacoes}}
<section class="section-block signature-line">
  <div class="signature-label">Observações</div>
  <p class="care-text">{{observacoes}}</p>
</section>
{{/if}}
