PORT=4000
# Origens extras para CORS (separadas por vírgula), além de localhost e clinievo.com.br
# ALLOWED_ORIGINS=https://preview-xxx.vercel.app
# Evolution API (WhatsApp) — VPS HostGator ou servidor próprio
EVOLUTION_API_URL=https://sua-evolution.seudominio.com
EVOLUTION_API_KEY=SUA_API_KEY_EVOLUTION
# true = aceita certificado autoassinado (comum em VPS com IP ou HTTPS sem Let's Encrypt)
EVOLUTION_TLS_INSECURE=false
# URL que a Evolution usa para chamar o backend (mensagens recebidas → secretária).
# Na VPS com Evolution em Docker, use o IP do host: http://129.121.52.242:4000
# ou http://172.17.0.1:4000 se a Evolution não alcançar o IP público.
CHATBOT_WEBHOOK_PUBLIC_URL=http://129.121.52.242:4000
# Listas interativas WhatsApp (Evolution sendList). false = só texto numerado
WHATSAPP_INTERACTIVE_LISTS=true
# Cobrança automática do Programa de Botox (Evolution API)
BOTOX_BILLING_ENABLED=true
BOTOX_BILLING_HOUR=9
# Opcional: protege POST /programa-botox/cobranca/daily quando chamado por cron externo
BOTOX_BILLING_CRON_SECRET=
# Lembretes automáticos de consulta (24h e 1h antes, via WhatsApp)
APPOINTMENT_REMINDER_ENABLED=true
APPOINTMENT_REMINDER_INTERVAL_MINUTES=15
# URL pública do app (links de relatório de tratamentos no bot)
APP_PUBLIC_URL=https://www.clinievo.com.br
# Intervalo entre envios em promoções em massa (ms)
WHATSAPP_PROMOTION_DELAY_MS=1500
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY
# Análise de exames com Groq (painel web)
ENABLE_AI_REPLY=false
# Reformulação das respostas da secretária WhatsApp — manter false (fluxo guiado por script)
ENABLE_AI_WHATSAPP_REPLY=false
GROQ_API_KEY=SEU_GROQ_API_KEY
GROQ_MODEL=llama-3.1-8b-instant
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
# Rate limit da API Express (em memória; 100 req/min/IP; webhook WhatsApp 300/min).
# IP correto exige trust proxy (já ativo no server.js).
EXAM_OCR_LANG=por
AI_REPLY_TONE=humano, objetivo e educado
AI_REPLY_STYLE=mensagens curtas e claras para WhatsApp
AI_REPLY_GOAL=guiar o paciente até concluir o agendamento
AI_REPLY_SIGNATURE=
