# =============================================================================
# Frontend (Vite) — NUNCA coloque aqui: SUPABASE_SERVICE_ROLE_KEY ou JWT_SECRET.
# Variáveis VITE_* são expostas no bundle do cliente.
# =============================================================================
# Supabase - substitua pelos valores do seu projeto em https://supabase.com/dashboard
VITE_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua_chave_anon_publica

# URL pública do app (obrigatório no APK) - usada nos links de PDF enviados via WhatsApp.
# Ex.: https://seu-app.vercel.app ou https://app.seudominio.com.br
VITE_APP_URL=https://seu-app.vercel.app

# URL base do n8n (sem barra no final)
VITE_N8N_WEBHOOK_URL=https://olintoguirao.app.n8n.cloud

# Backend do chatbot/WhatsApp (Evolution) — opcional no frontend.
# Em produção o app usa o proxy same-origin /api/chatbot (ver CHATBOT_BACKEND_URL na Vercel).
# Dev (Vite): proxy /api/chatbot usa CHATBOT_BACKEND_URL ou a VPS de produção por padrão.
# Backend local: CHATBOT_BACKEND_URL=http://localhost:4000 e `npm run backend`.
# VITE_CHATBOT_API_URL=

# =============================================================================
# Backend (Vercel serverless, ex.: /api/admin/users) — configure no painel da Vercel.
# Não commite valores reais. Nunca use variáveis com prefixo VITE_ para segredos.
# =============================================================================
# E-mail do administrador (obrigatório para criar novos perfis via painel admin)
# ADMIN_EMAIL=admin@seudominio.com.br

# Supabase (servidor): URL e chave de SERVIÇO (service role). Não exponha no frontend.
# SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role

# Upstash Redis: rate limit distribuído e proteção brute-force em /api (recomendado em produção).
# Sem Redis, usa contador em memória por isolate (ainda limita, mas menos eficaz em serverless).
# Crie um banco em https://console.upstash.com e defina na Vercel.
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx
# Em falha de Redis, por padrão NÃO libera tudo (usa memória). Só force com:
# RATE_LIMIT_FAIL_OPEN=true

# Proxy Vercel → backend Node na VPS (HTTP). Obrigatório para QR WhatsApp e cobrança Botox.
# CHATBOT_BACKEND_URL=http://129.121.52.242:4000
